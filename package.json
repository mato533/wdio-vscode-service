{
  "name": "wdio-vscode-service",
  "version": "6.1.3",
  "description": "A service to test VSCode extensions from end to end",
  "author": "Christian Bromann <mail@bromann.dev>",
  "homepage": "https://github.com/webdriverio-community/wdio-vscode-service",
  "license": "MIT",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typeScriptVersion": "3.8.3",
  "engines": {
    "node": "^16.13 || >=18"
  },
  "scripts": {
    "build": "run-s build:*",
    "build:ts": "tsc -b .",
    "build:copy": "shx cp ./src/chromium/index.cmd ./dist/chromium",
    "build:chmod": "chmod +x ./dist/chromium/index.js",
    "ci": "run-s test:lint build test",
    "clean": "rimraf ./node_modules ./dist",
    "docs": "typedoc",
    "prepare": "husky",
    "release": "release-it --github.release",
    "release:ci": "npm run release -- --ci --npm.skipChecks --no-git.requireCleanWorkingDir",
    "release:patch": "npm run release -- patch",
    "release:minor": "npm run release -- minor",
    "release:major": "npm run release -- major",
    "test": "run-s test:*",
    "test:setup": "node ./.github/scripts/link.mjs",
    "test:e2e": "run-s test:e2e:*",
    "test:e2e:run": "wdio run ./test/wdio.conf.ts",
    "test:e2e:cleanup": "git checkout -- package.json",
    "watch": "npm run build:ts -- --watch"
  },
  "keywords": [
    "webdriverio",
    "wdio",
    "wdio-service",
    "vscode",
    "tests"
  ],
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-electron": "^2.5.2",
    "@wdio/logger": "^9.16.2",
    "@xhmikosr/downloader": "^15.0.1",
    "clipboardy": "^4.0.0",
    "decamelize": "6.0.0",
    "fastify": "^5.4.0",
    "get-port": "7.1.0",
    "hpagent": "^1.2.0",
    "slash": "^5.1.0",
    "tmp-promise": "^3.0.3",
    "undici": "^7.11.0",
    "vscode-uri": "^3.1.0",
    "ws": "^8.18.3",
    "yargs-parser": "^22.0.0"
  },
  "peerDependencies": {
    "webdriverio": "*"
  },
  "peerDependenciesMeta": {
    "webdriverio": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/download": "^8.0.5",
    "@types/node": "^24.0.7",
    "@types/vscode": "^1.101.0",
    "@wdio/cli": "^9.16.2",
    "@wdio/globals": "^9.16.2",
    "@wdio/local-runner": "^9.16.2",
    "@wdio/mocha-framework": "^9.16.2",
    "@wdio/spec-reporter": "^9.16.2",
    "@wdio/types": "^9.16.2",
    "eslint": "^9.30.0",
    "eslint-plugin-wdio": "^9.16.2",
    "husky": "^9.1.7",
    "npm-run-all2": "^8.0.4",
    "release-it": "^19.0.3",
    "rimraf": "^6.0.1",
    "shx": "^0.4.0",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.6",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist/*",
    "src/server/fs-provider"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "edgedriver",
      "esbuild",
      "geckodriver",
      "unrs-resolver"
    ]
  }
}
